{
  "name": "open-creator-toolbox",
  "private": true,
  "description": "A lightweight desktop launcher for open-source creative tools",
  "license": "MIT",
  "repository": "github:wuzhongyanqiu/open-creator-toolbox",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "catalog:check": "node scripts/validate-catalog.mjs",
    "voice:check": "node scripts/check-voicestudio.mjs",
    "qa:android": "python3 scripts/mobile-qa/android-device.py",
    "qa:browser": "node scripts/mobile-qa/browser-matrix.mjs",
    "qa:check": "python3 -m unittest discover -s scripts/mobile-qa -p 'test_*.py' && node --check scripts/mobile-qa/browser-matrix.mjs && node --check scripts/mobile-qa/example-scenario.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide": "^1.52.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
